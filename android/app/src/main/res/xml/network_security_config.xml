<?xml version="1.0" encoding="utf-8"?>
<!-- AutoDeck only talks to GitHub (to look for updates) and Google Fonts, always over https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
